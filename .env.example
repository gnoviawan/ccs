# CCS Docker Environment Variables
# Copy this file to .env and customize as needed

# =============================================================================
# Dashboard Settings
# =============================================================================
NODE_ENV=production
CCS_CONTAINER_NAME=ccs-dashboard
CCS_CONFIG_DIR=/data/.ccs
CCS_DATA_DIR=/data/.ccs

# Dashboard bind address and port
CCS_DASHBOARD_HOST=0.0.0.0
CCS_DASHBOARD_PORT=3000

# External port mapping for dashboard proxy
CCS_PROXY_EXTERNAL_PORT=8318

# =============================================================================
# CLIProxy Settings
# =============================================================================
CLIPROXY_CONTAINER_NAME=ccs-cliproxy
CLIPROXY_PORT=8317
CLIPROXY_EXTERNAL_PORT=8319

# CLIProxy host for dashboard to connect (use service name in Docker)
CCS_PROXY_HOST=cliproxy
CCS_PROXY_PORT=8317

# Optional: Auth token for remote proxy access (recommended for production)
CCS_PROXY_AUTH_TOKEN=

# =============================================================================
# Dokploy / Production Settings
# =============================================================================
# Domain for dashboard UI (used by Traefik in Dokploy)
CCS_DOMAIN=ccs.example.com

# Domain for CLIProxy API (used by Traefik in Dokploy)
CLIPROXY_DOMAIN=api.ccs.example.com
