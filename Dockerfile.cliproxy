# CLIProxy API Docker Image
# Downloads and runs CLIProxyAPIPlus binary

FROM alpine:3.19

# Install required dependencies
RUN apk add --no-cache \
    wget \
    ca-certificates \
    libc6-compat \
    libstdc++

WORKDIR /app

# CLIProxy version to install
ARG CLIPROXY_VERSION=6.6.81-0

# Download and install CLIProxy binary for Linux
RUN wget -q "https://github.com/router-for-me/CLIProxyAPIPlus/releases/download/v${CLIPROXY_VERSION}/CLIProxyAPIPlus_${CLIPROXY_VERSION}_linux_amd64.tar.gz" -O cliproxy.tar.gz \
    && tar -xzf cliproxy.tar.gz \
    && rm cliproxy.tar.gz \
    && chmod +x cli-proxy-api-plus \
    && mv cli-proxy-api-plus /usr/local/bin/

# Create data directories
RUN mkdir -p /data/auth /data/config

# Create default config.yaml
RUN cat > /app/config.yaml << 'EOF'
# CLIProxyAPI config for Docker container
# Generated by CCS Docker setup

# =============================================================================
# Server Settings
# =============================================================================
port: 8317
debug: false

# =============================================================================
# Logging (disabled by default to save disk space)
# =============================================================================
logging-to-file: false
request-log: false

# =============================================================================
# Dashboard & Management
# =============================================================================
usage-statistics-enabled: true
remote-management:
  allow-remote: true
  secret-key: "ccs"
  disable-control-panel: false

# =============================================================================
# Reliability & Quota Management
# =============================================================================
request-retry: 0
max-retry-interval: 0
quota-exceeded:
  switch-project: true
  switch-preview-model: true

# =============================================================================
# Authentication
# =============================================================================
api-keys:
  - "ccs-internal-managed"

# OAuth tokens directory (shared with ccs-dashboard via volume mount)
auth-dir: "/data/.ccs/cliproxy/auth"
EOF

# Environment variables
ENV PORT=8317
ENV DATA_DIR=/data

# Expose the proxy port
EXPOSE 8317

# Health check (uses root endpoint which returns server info)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 -O /dev/null http://localhost:8317/ || exit 1

# Start CLIProxy
CMD ["cli-proxy-api-plus"]
